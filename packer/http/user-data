#cloud-config
autoinstall:
  version: 1
  identity:
    hostname: flash-vm
    username: nvidia
    # Password is "nvidia" (generated with: python3 -c "import crypt; print(crypt.crypt('nvidia', crypt.mksalt(crypt.METHOD_SHA512)))")
    password: "$6$sm.Byo.a777RnBCc$j.lciJXqMGGBF9JWy0ACbi.G51YvLyFMnbh5IFkVSdVrFlcTjHSSgbKp3FvKGAzbO7F6vYZXzdeCcYcbRmyyg0"
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct
  packages:
    - openssh-server
    - python3
    - qemu-guest-agent
  late-commands:
    - echo 'nvidia ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/nvidia
    - chmod 440 /target/etc/sudoers.d/nvidia
  user-data:
    disable_root: false
